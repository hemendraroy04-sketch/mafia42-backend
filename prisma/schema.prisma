generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id      Int    @id @default(autoincrement())
  name    String @unique
  country String

  rpRankings   RPRanking[]
  fameRankings FameRanking[]
}

model Guild {
  id      Int    @id @default(autoincrement())
  name    String @unique
  country String

  rankings GuildRanking[]
}

model RPRanking {
  id       Int      @id @default(autoincrement())
  date     DateTime
  rank     Int
  playerId Int
  rp       Int

  player Player @relation(fields: [playerId], references: [id])

  @@unique([date, rank])
  @@unique([date, playerId])
  @@index([date])
  @@index([playerId, date])
}

model FameRanking {
  id       Int      @id @default(autoincrement())
  date     DateTime
  rank     Int
  playerId Int
  fame     Int

  player Player @relation(fields: [playerId], references: [id])

  @@unique([date, rank])
  @@unique([date, playerId])
  @@index([date])
  @@index([playerId, date])
}

model GuildRanking {
  id      Int      @id @default(autoincrement())
  date    DateTime
  rank    Int
  guildId Int
  gp      Int

  guild Guild @relation(fields: [guildId], references: [id])

  @@unique([date, rank])
  @@unique([date, guildId])
  @@index([date])
  @@index([guildId, date])
}

model Event {
  id    Int         @id @default(autoincrement())
  name  String
  year  Int
  month Int
  image String
  boxes EventBox[]

  @@unique([name, year, month])
}

model EventBox {
  id      Int      @id @default(autoincrement())
  eventId Int
  name    String
  items   EventItem[]

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventItem {
  id          Int      @id @default(autoincrement())
  boxId       Int
  name        String
  image       String?
  probability Float

  box EventBox @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@index([boxId])
}